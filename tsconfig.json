{
  "compilerOptions": {
    // Enable latest features
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",

    // Bundler mode
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // JSX
    "jsx": "react-jsx",

    // Best practices
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "types": [
      "node",
      "vite/client",
      "vite-plus/test/globals",
      "vite-plus/test/importMeta"
    ],

    // better-css-modules が __generated__ に書く *.module.css の型を読む
    "rootDirs": [".", "./__generated__"]
  },
  "include": [
    "src",
    "vite.config.ts",
    "better-css-modules.config.ts",
    "__generated__"
  ]
}
